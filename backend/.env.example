# Configurações do Backend EV ChargeOps
PORT=8000
HOST=0.0.0.0

# Chave de API da OpenAI para a IA EVA (Opcional - a API conta com fallback inteligente sem chave)
OPENAI_API_KEY=

# Modelo da OpenAI utilizado
OPENAI_MODEL=gpt-4o-mini

# Tarifa padrão de rateio por kWh (R$/kWh)
DEFAULT_RATE_PER_KWH=0.95
